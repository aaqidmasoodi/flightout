; Yembera FlightOut
config_version=5

[application]

config/name="Yembera FlightOut"
config/description="FlightOut, a combat flight game by Yembera."
config/version="0.1.0"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/flightout_icon.svg"
boot_splash/bg_color=Color(0.03, 0.035, 0.045, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/ui/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]

Settings="*res://scripts/core/settings.gd"
Game="*res://scripts/core/game.gd"
WorldData="*res://scripts/world/world_data.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
